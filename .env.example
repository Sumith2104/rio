# =============================================================================
# REVA SMART CAMPUS PLATFORM - SMTP CREDENTIALS (NODEMAILER)
# =============================================================================
# To receive REAL OTP emails in your personal or university inbox:
# 1. Rename or copy this file to: .env
# 2. Fill in your outgoing SMTP credentials below.
#
# NOTE: If these variables are left empty, Nodemailer automatically falls back
# to Ethereal Email test SMTP transport with a web preview link on your screen.
# =============================================================================

# Option A: Brevo / Sendinblue / Gmail SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Student Success Platform <no-reply@reva.edu.in>"
SMTP_SECURE=false

# Optional: Override all OTP recipient emails to your personal test inbox
# SMTP_FORWARD_TO=your_personal_email@gmail.com

# Option B: Outlook / Office 365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your_email@outlook.com
# SMTP_PASS=your_password
# SMTP_FROM="REVA Smart Campus Auth" <your_email@outlook.com>

# Option C: Custom University / Corporate SMTP Server
# SMTP_HOST=smtp.reva.edu.in
# SMTP_PORT=587
# SMTP_USER=campus_mailer@reva.edu.in
# SMTP_PASS=your_secret_password
